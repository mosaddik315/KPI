rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDataOwner() {
      return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }
    
    function existingData() {
      return resource.data;
    }
    
    function incomingData() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && incomingData().email == request.auth.token.email;
      allow update: if isOwner(userId) && incomingData().email == existingData().email;
    }

    // KPIs
    match /kpis/{kpiId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isDataOwner() && isValidId(kpiId);
      allow update: if isSignedIn() && existingData().userId == request.auth.uid && isDataOwner();
      allow delete: if isSignedIn() && existingData().userId == request.auth.uid;
    }

    // Time Logs
    match /time_logs/{logId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isDataOwner() && isValidId(logId);
      allow update: if isSignedIn() && existingData().userId == request.auth.uid && isDataOwner();
      allow delete: if isSignedIn() && existingData().userId == request.auth.uid;
    }

    // Books
    match /books/{bookId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isDataOwner() && isValidId(bookId);
      allow update: if isSignedIn() && existingData().userId == request.auth.uid && isDataOwner();
      allow delete: if isSignedIn() && existingData().userId == request.auth.uid;
    }

    // Skills
    match /skills/{skillId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isDataOwner() && isValidId(skillId);
      allow update: if isSignedIn() && existingData().userId == request.auth.uid && isDataOwner();
      allow delete: if isSignedIn() && existingData().userId == request.auth.uid;
    }

    // SWOT
    match /swots/{swotId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isDataOwner() && isValidId(swotId);
      allow update: if isSignedIn() && existingData().userId == request.auth.uid && isDataOwner();
      allow delete: if isSignedIn() && existingData().userId == request.auth.uid;
    }
  }
}
